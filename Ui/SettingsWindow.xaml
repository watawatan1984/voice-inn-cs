<Window x:Class="VoiceIn.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice In 設定"
        Width="960" Height="680"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#161719"
        Foreground="#E3E3E5"
        FontFamily="Yu Gothic UI, Segoe UI, Meiryo"
        FontSize="13">
    <Window.Resources>
        <!-- ============================================================
             カラーパレット。ほぼ無彩のニュートラルグレーを基調とし、
             色は「状態」を示すときだけ使う (主アクション・警告・成功の3色のみ)。
             ============================================================ -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#161719"/>
        <SolidColorBrush x:Key="NavBgBrush" Color="#131416"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1D1E21"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#242528"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#2C2D31"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E3E3E5"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9B9CA1"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6C6D72"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4E7CC7"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C85A5A"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#5A9E6F"/>

        <!-- WPF 標準コントロールの「選択中」表示 (ListBox/DataGrid 等) を、System既定の
             鮮やかな青ではなくこの画面の配色に合わせる。ControlTemplate を書き換えずに
             安全に統一するため、SystemColors のキーそのものをここで上書きする。 -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#242528"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E3E3E5"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#242528"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E3E3E5"/>

        <!-- ============================================================
             タイポグラフィ。階層は「グループ見出し / 本文 / 補助説明」の3段のみ。
             ============================================================ -->
        <Style x:Key="GroupHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="HelperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="19.2"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="WarningHelperTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HelperTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- 既定 (無名) の TextBlock。上の名前付きスタイルを使わない TextBlock はこちらになる。 -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- ============================================================
             入力コントロール。角丸4px・罫線1px・フォーカス時のみ主アクション色。
             ============================================================ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SurfaceRaisedBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox は WPF 既定の ControlTemplate を使う限り Background 等の Setter が効かない
             (既定テンプレートは Windows テーマの chrome を独自に描画し、Background を無視する)。
             そのため ControlTemplate を丸ごと自作し、他のコントロールと同じ SurfaceBrush (背景) /
             DividerBrush (罫線) / TextPrimaryBrush (文字) で描画する。これにより「白い箱のまま
             浮いて見える」問題と「暗い chrome に薄文字で読めない」問題の両方を、テンプレート内で
             背景と前景を必ず一致させることで解消する。

             必須パーツ (名前を変えたり欠かすと ComboBox が正しく動かない、または実行時例外になる):
               - PART_EditableTextBox (TextBox): IsEditable="True" のときの編集可能な入力欄。
                 ComboBox 本体がこの名前でテンプレートから探し出し、入力文字列と ComboBox.Text の
                 同期・キー入力処理を自動で行う。
               - PART_Popup (Popup): ドロップダウン本体。ComboBox がこの名前で探し出し、
                 (外側クリック等で) Popup 自身が閉じたときに ComboBox.IsDropDownOpen を追従させる。
               - ToggleButton (名前は任意、下では "ToggleButton" とした): IsChecked を
                 IsDropDownOpen へ双方向バインドすることで開閉のトリガーにする。

             IsEditable の有無は ControlTemplate.Triggers で ContentPresenter (非編集時: 選択項目を
             表示) と PART_EditableTextBox (編集時: 自由入力) の Visibility を切り替えて両立させる。
             ToggleButton はコントロール全面を覆うが Background は透明で、右端にだけ矢印を描く。
             ContentPresenter は IsHitTestVisible="False" のため非編集時はクリックが素通りして
             ToggleButton に届き (=どこをクリックしても開く)、編集時は PART_EditableTextBox が
             ToggleButton の手前 (後勝ち) に重なるため、テキスト部分のクリックは編集用キャレット
             移動として扱われ、右端の矢印部分のクリックだけが開閉に使われる。

             旧実装ではここに Style.Resources で内部 TextBox (PART_EditableTextBox) を透明・
             枠無しにする回避策があったが、既定テンプレートを使わなくなった以上その回避策は
             意味を持たない (このテンプレートが PART_EditableTextBox に直接 Background="Transparent"
             等をローカル値として設定しており、ローカル値は暗黙スタイルより優先されるため、
             Window.Resources の無名 TextBox スタイルはそもそも上書きされる)。害はなくとも
             読み手を混乱させる死んだコードになるため削除した。 -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6,28,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>

                            <!-- 開閉トグル。コントロール全面を覆う透明ボタンとして最初に置き、
                                 後から重ねる ContentPresenter / PART_EditableTextBox より背面にする
                                 (XAML内での宣言順 = Z順、後勝ち)。右端にだけ矢印を描く。 -->
                            <ToggleButton x:Name="ToggleButton"
                                          Background="Transparent"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,11,0"
                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                  Data="M0,0 L9,0 L4.5,5 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- 非編集時: 選択中の項目を表示する。IsHitTestVisible="False" により
                                 クリックは背面の ToggleButton へ素通しする (どこを押しても開く)。
                                 IsEditable="True" のときは下のトリガーで Collapsed にする。 -->
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                            <!-- 編集時のみ使う入力欄 (既定は Collapsed)。ToggleButton より後に
                                 宣言することで手前に重なり、テキスト部分のクリックは編集用に
                                 消費され、右端の矢印部分 (このテキストボックスの右マージン分だけ
                                 露出している) のクリックだけが背面の ToggleButton に渡る。 -->
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="{TemplateBinding Padding}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     SelectionBrush="{StaticResource SurfaceRaisedBrush}"
                                     BorderThickness="0"
                                     Padding="0"
                                     FocusVisualStyle="{x:Null}"
                                     Focusable="True"
                                     Visibility="Collapsed"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>

                            <!-- ドロップダウン本体。名前 "PART_Popup" は ComboBox が自動で探す
                                 必須パーツ (Popup が自ら閉じたときに IsDropDownOpen を追従させる)。 -->
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   StaysOpen="False"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ドロップダウン内の各項目。既定テーマのままだと明るい面に描画され、
             閉じた状態 (暗色) と見た目が乖離するうえ、Foreground を薄色に揃えた際に
             「明背景に薄文字」で読めなくなる。項目側も暗色で明示的に塗る。 -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBg"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- ============================================================
             ボタン。フラット・グラデーション無し・影無し。角丸4px。
             既定 (無名スタイル) は副ボタン (罫線のみ) とし、主ボタンだけ明示的に
             PrimaryButtonStyle を指定する (アクセント色は1画面に1〜2箇所までに抑える)。
             ============================================================ -->
        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- ============================================================
             DataGrid (辞書・カテゴリキーワード・検出済みアプリ)。
             罫線は横線のみに絞り、選択色は上の SystemColors 上書きにより本パレットへ統一。
             ============================================================ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- ============================================================
             左サイドナビ。選択中の項目は SystemColors 上書きにより背景が
             わずかに明るくなるだけで、太いバー等の装飾は付けない。
             ============================================================ -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <!-- ScrollBar。既定テンプレートのままだと Windows テーマの明るい chrome
             (白に近い溝と矢印ボタン) がそのまま描かれ、暗色の画面に白い帯が縦に走って
             最も目立つ粗になる。ScrollViewer は本文の TextBox 内部にも現れるため、
             ここで一括して暗色に揃える。
             矢印ボタンは省き、溝と摘まみだけの細い形にする (情報量を増やさないため)。 -->
        <Style TargetType="Thumb" x:Key="ScrollThumbStyle">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBg"
                                Background="#3A3B40"
                                CornerRadius="3"
                                Margin="3"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBg" Property="Background" Value="#4C4D53"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBg" Property="Background" Value="#5A5B62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                                <!-- 矢印ボタンは置かない。溝のクリックによるページ送りだけ残す。 -->
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                        </Track.Thumb>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左サイドナビ -->
        <Border Grid.Column="0" Background="{StaticResource NavBgBrush}">
            <StackPanel Margin="0,32,0,0">
                <TextBlock Text="設定" Style="{StaticResource GroupHeadingStyle}" Margin="20,0,0,24"/>
                <ListBox x:Name="NavList"
                         BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectedIndex="{Binding SelectedIndex, ElementName=SectionsTabControl, Mode=TwoWay}">
                    <ListBoxItem Content="文字起こし"/>
                    <ListBoxItem Content="整形"/>
                    <ListBoxItem Content="マイク"/>
                    <ListBoxItem Content="録音"/>
                    <ListBoxItem Content="ローカル"/>
                    <ListBoxItem Content="プロンプト"/>
                    <ListBoxItem Content="辞書"/>
                    <ListBoxItem Content="カテゴリ"/>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- 右側コンテンツ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="SectionsTabControl" Grid.Row="0" SelectedIndex="0"
                        Background="{StaticResource WindowBgBrush}" BorderThickness="0" Padding="0">
                <TabControl.Resources>
                    <!-- 上部タブヘッダーは表示しない (左サイドナビで選択する)。TabItem.Visibility を
                         Collapsed にしてもヘッダーが非表示になるだけで、SelectedIndex による
                         コンテンツ切り替え自体には影響しない。 -->
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- 文字起こし設定 (旧「一般」タブから分離。1画面に詰め込みすぎて開いた直後から
                     縦スクロールが必要になっていたため、処理段階ごとにタブを分けた:
                     文字起こし / 整形 / マイク / 録音 の4画面。ナビ項目が増えることより
                     スクロール必須の画面が残ることの方が問題、という方針による。) -->
                <TabItem Header="文字起こし">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="32">
                            <TextBlock Text="文字起こし" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,16"/>
                            <TextBlock Style="{StaticResource HelperTextStyle}" Margin="0,0,0,12"
                                       Text="音声をテキスト化する設定です。プロバイダにより「整形」タブの設定が使われるかが変わります。"/>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="プロバイダ" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbProvider" Width="440" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="gemini"/>
                                    <ComboBoxItem Content="groq"/>
                                    <ComboBoxItem Content="local"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Gemini API キー: PasswordBox (マスク表示) と TextBox (平文表示) を重ねて、
                                 ボタンで Visibility を切り替える。既存キーがあっても実際の値は表示せず、
                                 下のステータス表示のみで「設定済み」を示す。 -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Gemini API キー" Style="{StaticResource FieldLabelStyle}"/>
                                <!-- 入力欄の幅は他の単一行入力 (440) と揃える。
                                     Width="*" のままだと親の幅に依存し、タブごとに右端が
                                     ずれて「揃っていない」印象になるため固定する。 -->
                                <Grid Width="440" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <PasswordBox x:Name="PwdGeminiApiKey"/>
                                        <TextBox x:Name="TxtGeminiApiKeyVisible" Visibility="Collapsed"/>
                                    </Grid>
                                    <Button x:Name="BtnToggleGeminiApiKey" Grid.Column="1" Content="表示"
                                            Click="OnToggleGeminiApiKeyVisibility" ToolTip="表示/非表示を切り替え"/>
                                </Grid>
                                <TextBlock x:Name="LblGeminiApiKeyStatus" Style="{StaticResource HelperTextStyle}"/>
                            </StackPanel>

                            <!-- Groq API キー: Gemini API キーと同じ構成。 -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Groq API キー" Style="{StaticResource FieldLabelStyle}"/>
                                <!-- 入力欄の幅は他の単一行入力 (440) と揃える。
                                     Width="*" のままだと親の幅に依存し、タブごとに右端が
                                     ずれて「揃っていない」印象になるため固定する。 -->
                                <Grid Width="440" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <PasswordBox x:Name="PwdGroqApiKey"/>
                                        <TextBox x:Name="TxtGroqApiKeyVisible" Visibility="Collapsed"/>
                                    </Grid>
                                    <Button x:Name="BtnToggleGroqApiKey" Grid.Column="1" Content="表示"
                                            Click="OnToggleGroqApiKeyVisibility" ToolTip="表示/非表示を切り替え"/>
                                </Grid>
                                <TextBlock x:Name="LblGroqApiKeyStatus" Style="{StaticResource HelperTextStyle}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Gemini モデル (文字起こし用)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtGeminiModel" Width="440" HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource HelperTextStyle}"
                                           Text="文字起こし用の Gemini モデルです (整形用とは別設定)。"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Groq Whisper モデル" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid Width="440" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbGroqWhisperModel" Grid.Column="0" Margin="0,0,8,0"
                                              IsEditable="True" IsTextSearchEnabled="False"/>
                                    <Button x:Name="BtnRefreshGroqWhisperModel" Grid.Column="1" Content="更新"
                                            Click="OnRefreshGroqWhisperModel" ToolTip="Groq からモデル一覧を取得します"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HelperTextStyle}"
                                           Text="Groq Whisper のモデル名です。一覧に無いモデル名も直接入力できます。空欄なら既定値 (whisper-large-v3) を使用します。"/>
                                <TextBlock x:Name="LblGroqWhisperModelStatus" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 整形設定 (旧「一般」タブから分離)。文字起こし後のテキストをさらに整えるバックエンドの設定。
                     文字起こしに Gemini を選んでいる場合はこの段自体が実行されないため、
                     その旨を警告色のヘルパーテキストで明示する。 -->
                <TabItem Header="整形">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="32">
                            <TextBlock Text="整形" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>
                            <TextBlock Style="{StaticResource WarningHelperTextStyle}" Margin="0,0,0,20"
                                       Text="文字起こしが Gemini のときは使われません。Groq のとき、またはローカルの「クラウドで整形」有効時のみ使われます。"/>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="整形バックエンド" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbRefineProvider" Width="440" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="gemini"/>
                                    <ComboBoxItem Content="nvidia"/>
                                </ComboBox>
                                <TextBlock Style="{StaticResource HelperTextStyle}"
                                           Text="gemini は文字起こしと同じ API キーを使います。nvidia の場合のみ下の NVIDIA キーが必要です。"/>
                            </StackPanel>

                            <!-- NVIDIA API キー: Gemini/Groq API キーと同じ構成。 -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="NVIDIA API キー" Style="{StaticResource FieldLabelStyle}"/>
                                <!-- 入力欄の幅は他の単一行入力 (440) と揃える。
                                     Width="*" のままだと親の幅に依存し、タブごとに右端が
                                     ずれて「揃っていない」印象になるため固定する。 -->
                                <Grid Width="440" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,8,0">
                                        <PasswordBox x:Name="PwdNvidiaApiKey"/>
                                        <TextBox x:Name="TxtNvidiaApiKeyVisible" Visibility="Collapsed"/>
                                    </Grid>
                                    <Button x:Name="BtnToggleNvidiaApiKey" Grid.Column="1" Content="表示"
                                            Click="OnToggleNvidiaApiKeyVisibility" ToolTip="表示/非表示を切り替え"/>
                                </Grid>
                                <TextBlock x:Name="LblNvidiaApiKeyStatus" Style="{StaticResource HelperTextStyle}"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Gemini モデル (整形用)" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid Width="440" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbGeminiRefineModel" Grid.Column="0" Margin="0,0,8,0"
                                              IsEditable="True" IsTextSearchEnabled="False"/>
                                    <Button x:Name="BtnRefreshGeminiRefineModel" Grid.Column="1" Content="更新"
                                            Click="OnRefreshGeminiRefineModel" ToolTip="Gemini からモデル一覧を取得します"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HelperTextStyle}"
                                           Text="整形用の Gemini モデルです (文字起こし用とは別)。一覧に無いモデル名も直接入力できます。空欄なら既定値を使用します。"/>
                                <TextBlock x:Name="LblGeminiRefineModelStatus" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="NVIDIA モデル (整形用)" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid Width="440" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbNvidiaRefineModel" Grid.Column="0" Margin="0,0,8,0"
                                              IsEditable="True" IsTextSearchEnabled="False"/>
                                    <Button x:Name="BtnRefreshNvidiaRefineModel" Grid.Column="1" Content="更新"
                                            Click="OnRefreshNvidiaRefineModel" ToolTip="NVIDIA からモデル一覧を取得します"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HelperTextStyle}"
                                           Text="整形用の NVIDIA モデルです。一覧に無いモデル名も直接入力できます。空欄なら既定値を使用します。"/>
                                <TextBlock x:Name="LblNvidiaRefineModelStatus" Style="{StaticResource HelperTextStyle}" Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- マイク設定 (旧「一般」タブから分離) -->
                <TabItem Header="マイク">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="32">
                            <TextBlock Text="マイク" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="入力デバイス" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="CmbMicDevice" Width="440" HorizontalAlignment="Left" SelectionChanged="OnMicDeviceSelectionChanged"/>
                            </StackPanel>

                            <!-- マイクテスト: 選択中のデバイスが実際に音を拾えているかをその場で確認するための
                                 レベルメーター。NAudio のキャプチャコールバックからは直接 UI を更新せず、
                                 DispatcherTimer (OnMicTestTimerTick) が AudioRecorder.CurrentMonitoringRms を
                                 ポーリングしてバーへ反映する (詳細は SettingsWindow.xaml.cs 参照)。 -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="マイクテスト" Style="{StaticResource FieldLabelStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="PbMicTestLevel" Grid.Column="0" Height="8" Minimum="0" Maximum="100"
                                                 Foreground="{StaticResource SuccessBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnToggleMicTest" Grid.Column="1" Content="マイクテスト開始" Width="160" Click="OnToggleMicTest"/>
                                </Grid>
                                <TextBlock Style="{StaticResource HelperTextStyle}"
                                           Text="話すとバーが動きます (録音・送信は行いません)。"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="入力ゲイン (dB)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="TxtInputGain" Width="120" HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource HelperTextStyle}" Text="マイク音量を dB 単位で増減します (-30.0 ~ 30.0 dB)。"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 録音設定 (旧「一般」タブから分離)。録音の挙動に加え、文字起こし後の
                     自動貼り付け・コンテキスト認識といった「動作」もここにまとめる
                     (プロンプトタブが1タブ内に「文字起こし用」「整形用」の2グループを
                     持つのと同じ構成)。 -->
                <TabItem Header="録音">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="32">

                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="録音" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="録音キー" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="CmbHoldKey" Width="440" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="alt_l (左Alt)"/>
                                        <ComboBoxItem Content="alt_r (右Alt)"/>
                                        <ComboBoxItem Content="ctrl_l (左Ctrl)"/>
                                        <ComboBoxItem Content="ctrl_r (右Ctrl)"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="最大録音時間 (秒)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMaxRecord" Width="120" HorizontalAlignment="Left"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="最小録音時間 (秒)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMinDuration" Width="120" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource HelperTextStyle}" Text="これより短い録音は無音とみなして破棄されます (0.2 ~ 5.0 秒)。"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="貼り付け遅延 (ms)" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtPasteDelay" Width="120" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- グループ: 動作 -->
                            <StackPanel>
                                <TextBlock Text="動作" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>
                                <CheckBox x:Name="ChkAutoPaste" Content="文字起こし後に自動で貼り付ける (Auto Paste)" Margin="0,0,0,20"/>
                                <CheckBox x:Name="ChkContextAware" Content="コンテキスト認識によるプロンプト最適化を有効にする"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ローカル (オフライン) 設定 -->
                <TabItem Header="ローカル">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="32">

                            <TextBlock Style="{StaticResource HelperTextStyle}" Margin="0,0,0,20"
                                       Text="API キーやネット接続なしで、PC 上の Whisper モデルのみで文字起こしします。"/>

                            <!-- グループ: モデル -->
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="モデル" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>
                                <StackPanel>
                                    <TextBlock Text="モデルサイズ" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="CmbLocalModelSize" Width="440" HorizontalAlignment="Left" SelectionChanged="OnLocalModelSizeChanged"/>
                                    <TextBlock Style="{StaticResource HelperTextStyle}"
                                               Text="サイズが大きいほど認識精度が上がりますが、ダウンロード容量と読み込み時間も増えます。"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- グループ: 実行方法 -->
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="実行方法" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>

                                <StackPanel Margin="0,0,0,20">
                                    <CheckBox x:Name="ChkLocalUseGpu" Content="GPU を使う (NVIDIA CUDA)"/>
                                    <TextBlock Style="{StaticResource HelperTextStyle}" Text="NVIDIA GPU が使えない環境では自動的に CPU で動作します。"/>
                                </StackPanel>

                                <!-- 【欠陥6】以前は「クラウド (Groq) の LLM で整形」と表記していたが、整形は
                                     Groq から切り離され「整形」タブの設定 (Gemini/NVIDIA) に従うため誤り。
                                     整形バックエンドを指す固有名詞を書かず、「整形」タブへの参照に統一する
                                     (バックエンドが将来変わってもここを直さずに済む)。 -->
                                <StackPanel>
                                    <CheckBox x:Name="ChkLocalRefineWithCloud" Content="クラウドで整形する (ハイブリッド)"/>
                                    <TextBlock Style="{StaticResource WarningHelperTextStyle}"
                                               Text="「整形」タブの設定でクラウド整形します (ネット接続必須・テキストが外部送信されます)。"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- グループ: モデルの状態。カードで囲わず、余白のみで前後のグループと区切る。 -->
                            <StackPanel>
                                <TextBlock Text="モデルの状態" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>
                                <TextBlock x:Name="LblLocalModelStatus" TextWrapping="Wrap" Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button x:Name="BtnDownloadModel" Content="モデルをダウンロード" Style="{StaticResource PrimaryButtonStyle}" Click="OnDownloadModel"/>
                                    <Button x:Name="BtnCancelModelDownload" Content="キャンセル" Click="OnCancelModelDownload"
                                            Margin="12,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <ProgressBar x:Name="PbModelDownload" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,12"/>
                                <TextBlock x:Name="LblModelDownloadStatus" Style="{StaticResource HelperTextStyle}" Margin="0" Visibility="Collapsed"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- プロンプト設定 -->
                <TabItem Header="プロンプト">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="32">

                            <!-- グループ: 文字起こし用プロンプト -->
                            <StackPanel Margin="0,0,0,40">
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="文字起こし用プロンプト" Style="{StaticResource GroupHeadingStyle}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="既定に戻す" Click="OnResetTranscribePromptsToDefault"/>
                                </Grid>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="Gemini プロンプト" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtGeminiPrompt" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Text="Groq Whisper プロンプト" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtGroqWhisperPrompt" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- グループ: 整形用プロンプト -->
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="整形用プロンプト" Style="{StaticResource GroupHeadingStyle}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="既定に戻す" Click="OnResetRefinePromptToDefault"/>
                                </Grid>

                                <!-- 【欠陥6】旧表記「Groq 文章整形 (LLaMA) プロンプト」は誤り。整形は既に
                                     Groq から切り離され Gemini / NVIDIA が担当し、LLaMA は製品から削除済み。
                                     表示文言のみ「整形プロンプト」に修正する。x:Name (TxtGroqRefinePrompt) と
                                     Core/Settings.cs のプロパティ名 (GroqRefineSystemPrompt) は、JSON
                                     キー名の後方互換のためあえて変更しない (指示どおり表示文言のみ修正)。 -->
                                <StackPanel>
                                    <TextBlock Text="整形プロンプト" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="TxtGroqRefinePrompt" Height="170" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 辞書設定 -->
                <TabItem Header="辞書">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="辞書" Style="{StaticResource GroupHeadingStyle}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="既定に戻す" Click="OnResetDictionaryToDefault"/>
                            </Grid>

                            <DataGrid x:Name="GridDictionary" AutoGenerateColumns="False" CanUserAddRows="True" Height="360" Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="置換前 (From)" Binding="{Binding From}" Width="*"/>
                                    <DataGridTextColumn Header="置換後 (To)" Binding="{Binding To}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Content="選択項目を削除" Click="OnDeleteDictItem" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Style="{StaticResource HelperTextStyle}" Margin="0" Text="認識結果の単語置換ルールを登録します。"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- カテゴリ設定 -->
                <TabItem Header="カテゴリ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32">

                            <!-- グループ: 分類ルール -->
                            <StackPanel Margin="0,0,0,40">
                                <TextBlock Text="分類ルール" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="カテゴリ" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="CmbCategory" Width="440" HorizontalAlignment="Left" SelectionChanged="OnCategorySelectionChanged"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,20">
                                    <TextBlock Text="分類キーワード" Style="{StaticResource FieldLabelStyle}"/>
                                    <DataGrid x:Name="GridCategoryKeywords" AutoGenerateColumns="False" CanUserAddRows="True" Height="140" Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="キーワード" Binding="{Binding Keyword}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="選択項目を削除" Click="OnDeleteCategoryKeywordItem" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource HelperTextStyle}" Margin="0" Text="アプリ名やウィンドウタイトルに含まれる文字列を登録します。"/>
                                </StackPanel>

                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="カテゴリ別プロンプト" Style="{StaticResource FieldLabelStyle}" Margin="0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="既定に戻す" Click="OnResetCategoryPromptToDefault"/>
                                    </Grid>
                                    <TextBox x:Name="TxtCategoryPrompt" Height="130" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Style="{StaticResource HelperTextStyle}" Text="このカテゴリのウィンドウで文字起こしする際に使う追加指示です。"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- グループ: 検出済みアプリ。移植元 Python 版の「検出済みアプリ」パネル相当。
                                 ユーザーが普段使うアプリがどの名前・カテゴリで認識されているかを確認し、
                                 キーワードとして何を追加すればよいかの手掛かりを得るための一覧。 -->
                            <StackPanel>
                                <TextBlock Text="検出済みアプリ" Style="{StaticResource GroupHeadingStyle}" Margin="0,0,0,20"/>
                                <TextBlock Style="{StaticResource HelperTextStyle}" Margin="0,0,0,20"
                                           Text="検出した新しいアプリ名を自動追加します (ウィンドウタイトル例も保存され、文書名等を含む場合があります)。カテゴリを割り当てるとキーワードにも追加されます。"/>

                                <DataGrid x:Name="GridDetectedApps" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                          SelectionMode="Single" Height="200" Margin="0,0,0,20">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="アプリ名" Binding="{Binding AppName}" Width="*"/>
                                        <DataGridTextColumn Header="自動判定" Binding="{Binding AutoCategory}" Width="Auto"/>
                                        <DataGridTextColumn Header="現在の割り当て" Binding="{Binding UserCategoryDisplay}" Width="Auto"/>
                                        <DataGridTextColumn Header="検出時のタイトル例 (保存されます)" Binding="{Binding TitleSample}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="割り当て先" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="CmbAssignCategory" Grid.Column="1"/>
                                    <Button Grid.Column="2" Content="カテゴリを割り当て" Click="OnAssignDetectedAppCategory" Margin="12,0,0,0"/>
                                    <Button Grid.Column="4" Content="履歴をクリア" Click="OnClearDetectedApps" Style="{StaticResource DangerOutlineButtonStyle}"/>
                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- 下部操作ボタン。コンテンツのスクロールと分離して画面下部に固定する。
                 罫線は「本当に必要な1〜2箇所」の1つとしてここにだけ使い、
                 スクロール領域と固定フッターの境界を示す。 -->
            <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="32,20,32,20">
                    <Button Content="キャンセル" Click="OnCancel" Margin="0,0,12,0"/>
                    <Button Content="保存して適用" Click="OnSaveAndApply" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
