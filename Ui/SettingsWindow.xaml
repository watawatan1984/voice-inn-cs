<Window x:Class="VoiceIn.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice In 設定"
        Width="640" Height="740"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Meiryo">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Background="#181825" BorderBrush="#313244">
            <!-- 一般設定 -->
            <TabItem Header="一般">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AI プロバイダ:"/>
                            <ComboBox x:Name="CmbProvider" Grid.Column="1">
                                <ComboBoxItem Content="gemini"/>
                                <ComboBoxItem Content="groq"/>
                                <ComboBoxItem Content="local"/>
                            </ComboBox>
                        </Grid>

                        <!-- Gemini API キー: PasswordBox (マスク表示) と TextBox (平文表示) を重ねて、
                             ボタンで Visibility を切り替える。既存キーがあっても実際の値は表示せず、
                             下のステータス表示のみで「設定済み」を示す。 -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gemini API キー:"/>
                            <Grid Grid.Column="1" Margin="0,0,4,0">
                                <PasswordBox x:Name="PwdGeminiApiKey"/>
                                <TextBox x:Name="TxtGeminiApiKeyVisible" Visibility="Collapsed"/>
                            </Grid>
                            <Button x:Name="BtnToggleGeminiApiKey" Grid.Column="2" Content="👁" Width="36" Padding="0"
                                    Click="OnToggleGeminiApiKeyVisibility" ToolTip="表示/非表示を切り替え"/>
                        </Grid>
                        <TextBlock x:Name="LblGeminiApiKeyStatus" FontSize="11" Foreground="#A6ADC8" Margin="140,0,0,10"/>

                        <!-- Groq API キー: Gemini API キーと同じ構成。 -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Groq API キー:"/>
                            <Grid Grid.Column="1" Margin="0,0,4,0">
                                <PasswordBox x:Name="PwdGroqApiKey"/>
                                <TextBox x:Name="TxtGroqApiKeyVisible" Visibility="Collapsed"/>
                            </Grid>
                            <Button x:Name="BtnToggleGroqApiKey" Grid.Column="2" Content="👁" Width="36" Padding="0"
                                    Click="OnToggleGroqApiKeyVisibility" ToolTip="表示/非表示を切り替え"/>
                        </Grid>
                        <TextBlock x:Name="LblGroqApiKeyStatus" FontSize="11" Foreground="#A6ADC8" Margin="140,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gemini モデル:"/>
                            <TextBox x:Name="TxtGeminiModel" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="マイク入力デバイス:"/>
                            <ComboBox x:Name="CmbMicDevice" Grid.Column="1" SelectionChanged="OnMicDeviceSelectionChanged"/>
                        </Grid>

                        <!-- マイクテスト: 選択中のデバイスが実際に音を拾えているかをその場で確認するための
                             レベルメーター。NAudio のキャプチャコールバックからは直接 UI を更新せず、
                             DispatcherTimer (OnMicTestTimerTick) が AudioRecorder.CurrentMonitoringRms を
                             ポーリングしてバーへ反映する (詳細は SettingsWindow.xaml.cs 参照)。 -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="マイクテスト:"/>
                            <ProgressBar x:Name="PbMicTestLevel" Grid.Column="1" Height="18" Minimum="0" Maximum="100"
                                         Foreground="#A6E3A1" Background="#313244" BorderBrush="#45475A" BorderThickness="1" Margin="0,0,8,0"/>
                            <Button x:Name="BtnToggleMicTest" Grid.Column="2" Content="▶ マイクテスト開始" Width="160" Click="OnToggleMicTest"/>
                        </Grid>
                        <TextBlock Text="開始すると、選択中のデバイスに向かって話したときにバーが動きます (ファイルへの保存や送信は一切行いません)。"
                                   TextWrapping="Wrap" FontSize="11" Foreground="#A6ADC8" Margin="140,0,0,10"/>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="入力ゲイン (dB):"/>
                            <TextBox x:Name="TxtInputGain" Grid.Column="1"/>
                        </Grid>
                        <TextBlock Text="マイク音量を dB 単位で増減します (-30.0 ~ 30.0 dB)。" FontSize="11" Foreground="#A6ADC8" Margin="140,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="録音キー:"/>
                            <ComboBox x:Name="CmbHoldKey" Grid.Column="1">
                                <ComboBoxItem Content="alt_l (左Alt)"/>
                                <ComboBoxItem Content="alt_r (右Alt)"/>
                                <ComboBoxItem Content="ctrl_l (左Ctrl)"/>
                                <ComboBoxItem Content="ctrl_r (右Ctrl)"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大録音時間 (秒):"/>
                            <TextBox x:Name="TxtMaxRecord" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最小録音時間 (秒):"/>
                            <TextBox x:Name="TxtMinDuration" Grid.Column="1"/>
                        </Grid>
                        <TextBlock Text="これより短い録音は無音とみなして破棄されます (0.2 ~ 5.0 秒)。" FontSize="11" Foreground="#A6ADC8" Margin="140,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="貼り付け遅延 (ms):"/>
                            <TextBox x:Name="TxtPasteDelay" Grid.Column="1"/>
                        </Grid>

                        <CheckBox x:Name="ChkAutoPaste" Content="文字起こし後に自動で貼り付ける (Auto Paste)" Foreground="#CDD6F4" Margin="0,6,0,8"/>
                        <CheckBox x:Name="ChkContextAware" Content="コンテキスト認識によるプロンプト最適化を有効にする" Foreground="#CDD6F4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ローカル (オフライン) 設定 -->
            <TabItem Header="ローカル">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="ローカル (オフライン) 文字起こしの設定です。API キーやインターネット接続なしで、PC 上の Whisper モデルのみを使って文字起こしします。"
                                   TextWrapping="Wrap" Foreground="#A6ADC8" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="モデルサイズ:"/>
                            <ComboBox x:Name="CmbLocalModelSize" Grid.Column="1" SelectionChanged="OnLocalModelSizeChanged"/>
                        </Grid>
                        <TextBlock Text="サイズが大きいほど認識精度が上がりますが、ダウンロード容量と読み込み時間も増えます。"
                                   FontSize="11" Foreground="#A6ADC8" Margin="140,0,0,14"/>

                        <CheckBox x:Name="ChkLocalUseGpu" Content="GPU を使う (NVIDIA CUDA)" Foreground="#CDD6F4" Margin="0,0,0,2"/>
                        <TextBlock Text="NVIDIA GPU が使えない環境では自動的に CPU で動作します。"
                                   FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkLocalRefineWithCloud" Content="クラウドで整形する (ハイブリッド)" Foreground="#CDD6F4" Margin="0,0,0,2"/>
                        <TextBlock Text="有効にすると、ローカルで文字起こしした結果をさらにクラウド (Groq) の LLM で整形します。オフラインでなくなり、API キーとネットワーク接続が必要になります。音声由来のテキストが外部へ送信される点に注意してください。"
                                   TextWrapping="Wrap" FontSize="11" Foreground="#F38BA8" Margin="0,0,0,14"/>

                        <Border Background="#181825" CornerRadius="6" Padding="14" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="モデルの状態" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="LblLocalModelStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnDownloadModel" Content="モデルをダウンロード" Click="OnDownloadModel"/>
                                    <Button x:Name="BtnCancelModelDownload" Content="キャンセル" Click="OnCancelModelDownload"
                                            Background="#F38BA8" Foreground="#11111B" Margin="8,0,0,0" Visibility="Collapsed"/>
                                </StackPanel>

                                <ProgressBar x:Name="PbModelDownload" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                <TextBlock x:Name="LblModelDownloadStatus" TextWrapping="Wrap" FontSize="11" Foreground="#A6ADC8" Margin="0,6,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- プロンプト設定 -->
            <TabItem Header="プロンプト">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Gemini プロンプト:" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtGeminiPrompt" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                        <TextBlock Text="Groq Whisper プロンプト:" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtGroqWhisperPrompt" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

                        <TextBlock Text="Groq 文章整形 (LLaMA) プロンプト:" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtGroqRefinePrompt" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 辞書設定 -->
            <TabItem Header="辞書">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="認識結果の単語置換ルールを登録します。" Margin="0,0,0,8"/>

                    <DataGrid x:Name="GridDictionary" Grid.Row="1" AutoGenerateColumns="False" 
                              Background="#313244" Foreground="#CDD6F4" CanUserAddRows="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="置換前 (From)" Binding="{Binding From}" Width="*"/>
                            <DataGridTextColumn Header="置換後 (To)" Binding="{Binding To}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Content="選択項目を削除" Click="OnDeleteDictItem" HorizontalAlignment="Left" Margin="0,8,0,0" Background="#F38BA8"/>
                </Grid>
            </TabItem>

            <!-- カテゴリ設定 -->
            <TabItem Header="カテゴリ">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="アクティブウィンドウの分類に使うキーワードと、カテゴリ別のプロンプトを編集します。" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="カテゴリ:"/>
                        <ComboBox x:Name="CmbCategory" Grid.Column="1" SelectionChanged="OnCategorySelectionChanged"/>
                    </Grid>

                    <TextBlock Grid.Row="2" Text="分類キーワード (アプリ名やウィンドウタイトルに含まれる文字列):" Margin="0,0,0,6"/>

                    <DataGrid x:Name="GridCategoryKeywords" Grid.Row="3" AutoGenerateColumns="False"
                              Background="#313244" Foreground="#CDD6F4" CanUserAddRows="True" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="キーワード" Binding="{Binding Keyword}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="4" Content="選択項目を削除" Click="OnDeleteCategoryKeywordItem" HorizontalAlignment="Left" Margin="0,0,0,12" Background="#F38BA8"/>

                    <TextBlock Grid.Row="5" Text="カテゴリ別プロンプト (このカテゴリのウィンドウで文字起こしする際に使う追加指示):" FontWeight="Bold" Margin="0,0,0,6"/>

                    <TextBox x:Name="TxtCategoryPrompt" Grid.Row="6" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                    <!-- 検出済みアプリ履歴。移植元 Python 版の「検出済みアプリ」パネル相当。
                         ユーザーが普段使うアプリがどの名前・カテゴリで認識されているかを確認し、
                         キーワードとして何を追加すればよいかの手掛かりを得るための一覧。 -->
                    <StackPanel Grid.Row="7" Margin="0,14,0,6">
                        <TextBlock Text="検出済みアプリ履歴" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="11"
                                   Text="アクティブウィンドウを検出するたびに、まだ一覧に無いアプリ名だけが自動的に追加されます (発話のたびにファイルへ書き込むことはありません)。アプリ名・自動判定カテゴリに加えて、検出時のウィンドウタイトルの例も設定ファイルに保存されます。ウィンドウタイトルには文書名やメールの件名、チャット相手の名前などが含まれる場合がある点にご注意ください。下の一覧からアプリを選んでカテゴリを割り当てると、そのカテゴリのキーワードにも自動的に追加されます。"/>
                    </StackPanel>

                    <DataGrid x:Name="GridDetectedApps" Grid.Row="8" AutoGenerateColumns="False"
                              Background="#313244" Foreground="#CDD6F4" CanUserAddRows="False" IsReadOnly="True"
                              SelectionMode="Single" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="アプリ名" Binding="{Binding AppName}" Width="*"/>
                            <DataGridTextColumn Header="自動判定" Binding="{Binding AutoCategory}" Width="Auto"/>
                            <DataGridTextColumn Header="現在の割り当て" Binding="{Binding UserCategoryDisplay}" Width="Auto"/>
                            <DataGridTextColumn Header="検出時のタイトル例 (保存されます)" Binding="{Binding TitleSample}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="割り当て先:" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbAssignCategory" Grid.Column="1"/>
                        <Button Grid.Column="2" Content="カテゴリを割り当て" Click="OnAssignDetectedAppCategory" Margin="8,0,0,0"/>
                        <Button Grid.Column="4" Content="履歴をクリア" Click="OnClearDetectedApps" Background="#F38BA8" Foreground="#11111B"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 下部操作ボタン -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Click="OnCancel" Background="#45475A" Foreground="#CDD6F4" Margin="0,0,8,0"/>
            <Button Content="保存して適用" Click="OnSaveAndApply" Background="#A6E3A1" Foreground="#11111B"/>
        </StackPanel>
    </Grid>
</Window>
