<Window x:Class="VoiceIn.Ui.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice In - 初期セットアップ"
        Width="640" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        FontFamily="Segoe UI, Meiryo">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtStepIndicator" Grid.Row="0" FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,14"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- ページ1: ようこそ -->
                <StackPanel x:Name="PageWelcome">
                    <TextBlock Text="Voice In へようこそ" FontSize="22" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                    <TextBlock Text="Voice In は、キーを押しながら話すだけで AI が音声を文字に変換し、結果を自動でアクティブなアプリへ貼り付ける常駐型の音声入力ツールです。"
                               TextWrapping="Wrap" FontSize="13" Margin="0,0,0,18"/>
                    <Border Background="#313244" CornerRadius="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="このウィザードでは、次の内容を設定します" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="1. 利用する AI プロバイダと API キー" Margin="0,0,0,4"/>
                            <TextBlock Text="2. マイク入力デバイス" Margin="0,0,0,4"/>
                            <TextBlock Text="3. 録音に使う操作キー" Margin="0,0,0,4"/>
                            <TextBlock Text="「次へ」を押して進めてください。設定はあとからトレイメニューの「設定...」からいつでも変更できます。"
                                       TextWrapping="Wrap" Foreground="#A6ADC8" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ページ2: AIプロバイダとAPIキー -->
                <StackPanel x:Name="PageProvider" Visibility="Collapsed">
                    <TextBlock Text="AI プロバイダと API キー" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,6"/>
                    <TextBlock Text="文字起こしに使用する AI プロバイダを選択し、API キーを入力してください。"
                               TextWrapping="Wrap" Foreground="#A6ADC8" Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <RadioButton x:Name="RbGemini" Content="Gemini" GroupName="Provider" Checked="OnProviderChanged"/>
                        <RadioButton x:Name="RbGroq" Content="Groq" GroupName="Provider" Checked="OnProviderChanged"/>
                        <RadioButton x:Name="RbLocal" Content="ローカル (オフライン)" GroupName="Provider" Checked="OnProviderChanged"/>
                    </StackPanel>

                    <!-- Gemini 用の入力欄 -->
                    <StackPanel x:Name="PanelGeminiFields">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gemini API キー:"/>
                            <Grid Grid.Column="1" Margin="0,0,4,0">
                                <PasswordBox x:Name="PwdGeminiApiKey" PasswordChanged="OnGeminiApiKeyPasswordChanged"/>
                                <TextBox x:Name="TxtGeminiApiKeyVisible" Visibility="Collapsed" TextChanged="OnGeminiApiKeyTextChanged"/>
                            </Grid>
                            <Button x:Name="BtnToggleGeminiApiKey" Grid.Column="2" Content="👁" Width="36" Padding="0"
                                    Click="OnToggleGeminiApiKeyVisibility" ToolTip="表示/非表示を切り替え"/>
                        </Grid>
                        <TextBlock x:Name="LblGeminiApiKeyStatus" FontSize="11" Foreground="#A6ADC8" Margin="120,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Gemini モデル:"/>
                            <TextBox x:Name="TxtGeminiModel" Grid.Column="1"/>
                        </Grid>

                        <TextBlock Text="API キーの取得先: Google AI Studio (aistudio.google.com/apikey) で発行できます。"
                                   TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Groq 用の入力欄 -->
                    <StackPanel x:Name="PanelGroqFields" Visibility="Collapsed">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Groq API キー:"/>
                            <Grid Grid.Column="1" Margin="0,0,4,0">
                                <PasswordBox x:Name="PwdGroqApiKey" PasswordChanged="OnGroqApiKeyPasswordChanged"/>
                                <TextBox x:Name="TxtGroqApiKeyVisible" Visibility="Collapsed" TextChanged="OnGroqApiKeyTextChanged"/>
                            </Grid>
                            <Button x:Name="BtnToggleGroqApiKey" Grid.Column="2" Content="👁" Width="36" Padding="0"
                                    Click="OnToggleGroqApiKeyVisibility" ToolTip="表示/非表示を切り替え"/>
                        </Grid>
                        <TextBlock x:Name="LblGroqApiKeyStatus" FontSize="11" Foreground="#A6ADC8" Margin="120,0,0,12"/>

                        <TextBlock Text="API キーの取得先: Groq Console (console.groq.com/keys) で発行できます。"
                                   TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- ローカル (オフライン) 用の案内 -->
                    <StackPanel x:Name="PanelLocalFields" Visibility="Collapsed">
                        <TextBlock Text="ローカル (オフライン) は、インターネット接続や API キーなしで、PC 上の Whisper モデルのみを使って文字起こしします。"
                                   TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,10"/>
                        <TextBlock x:Name="LblLocalModelStatus" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                        <TextBlock Text="モデルが未取得の場合は、セットアップ完了後にトレイメニューの「設定...」からダウンロードしてください。"
                                   TextWrapping="Wrap" Foreground="#A6ADC8" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- ページ3: マイクデバイス -->
                <StackPanel x:Name="PageDevice" Visibility="Collapsed">
                    <TextBlock Text="マイクデバイス" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,6"/>
                    <TextBlock Text="音声入力に使うマイクを選択してください。迷う場合は「既定のデバイス」のままで問題ありません。"
                               TextWrapping="Wrap" Foreground="#A6ADC8" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="マイク入力デバイス:"/>
                        <ComboBox x:Name="CmbMicDevice" Grid.Column="1"/>
                    </Grid>
                </StackPanel>

                <!-- ページ4: 操作キー -->
                <StackPanel x:Name="PageControls" Visibility="Collapsed">
                    <TextBlock Text="操作キー" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,6"/>
                    <TextBlock Text="録音に使うキーを選択してください。選択したキーを押している間だけ録音され、離すと自動で文字起こしが行われます。"
                               TextWrapping="Wrap" Foreground="#A6ADC8" Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="録音キー:"/>
                        <ComboBox x:Name="CmbHoldKey" Grid.Column="1">
                            <ComboBoxItem Content="alt_l (左Alt)"/>
                            <ComboBoxItem Content="alt_r (右Alt)"/>
                            <ComboBoxItem Content="ctrl_l (左Ctrl)"/>
                            <ComboBoxItem Content="ctrl_r (右Ctrl)"/>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="ChkAutoPaste" Content="文字起こし後に自動で貼り付ける (Auto Paste)" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- ページ5: 完了 -->
                <StackPanel x:Name="PageFinish" Visibility="Collapsed">
                    <TextBlock Text="設定完了" FontSize="22" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>
                    <TextBlock Text="以下の内容で設定します。「完了」を押すと保存されます。" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="#313244" CornerRadius="6" Padding="18" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtSummary" TextWrapping="Wrap" FontSize="13" LineHeight="24"/>
                    </Border>

                    <Border Background="#181825" CornerRadius="6" Padding="18">
                        <StackPanel>
                            <TextBlock Text="使い方" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="1. 設定したキーを押し続ける" Margin="0,0,0,4"/>
                            <TextBlock Text="2. 話す" Margin="0,0,0,4"/>
                            <TextBlock Text="3. キーを離すと自動で文字起こしされ、アクティブウィンドウへ貼り付けられます"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 下部ナビゲーション -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnCancel" Grid.Column="0" Content="キャンセル" Click="OnCancel" Background="#45475A" Foreground="#CDD6F4"/>
            <Button x:Name="BtnBack" Grid.Column="2" Content="戻る" Click="OnBack" Background="#45475A" Foreground="#CDD6F4" Margin="0,0,8,0"/>
            <Button x:Name="BtnNext" Grid.Column="3" Content="次へ" Click="OnNext" Background="#A6E3A1" Foreground="#11111B"/>
        </Grid>
    </Grid>
</Window>
