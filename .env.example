# Voice In - Environment Variables Configuration
# 以下の値を設定してください（本番用 .env は git にコミットしないでください）

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# --- モデルの明示指定 (任意) ---------------------------------------------
# 未設定なら下記の既定値が使われます。プロバイダ側でモデルの提供が終了した
# 場合は、ここで差し替えれば再ビルドせずに復旧できます。
#
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_WHISPER_MODEL=whisper-large-v3
# GROQ_REFINE_MODEL=openai/gpt-oss-120b
#
# GROQ_REFINE_MODEL には qwen/qwen3.8-27b も指定できます (約3倍高速)。
# ただし整形結果にマークダウンのバッククォートが混ざることがあり、
# 貼り付け先によっては記号がそのまま入る点に注意してください。
