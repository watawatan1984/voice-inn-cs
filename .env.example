# Voice In - Environment Variables Configuration
# 以下の値を設定してください（本番用 .env は git にコミットしないでください）

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# NVIDIA_API_KEY: 整形バックエンド (settings.json の refine_provider) を "nvidia" に
# した場合にのみ必要。OpenAI 互換の Chat Completions API (Authorization: Bearer) を使う。
NVIDIA_API_KEY=your_nvidia_api_key_here
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# --- モデルの明示指定 (任意) ---------------------------------------------
# 未設定なら下記の既定値が使われます。プロバイダ側でモデルの提供が終了した
# 場合は、ここで差し替えれば再ビルドせずに復旧できます。
#
# GEMINI_MODEL=gemini-2.5-flash
#   GeminiProvider が音声から直接文字起こしする際に使うモデル。
# GROQ_WHISPER_MODEL=whisper-large-v3
#   Groq Whisper の文字起こしモデル。Groq は文字起こし専用であり、整形は行わない
#   (Groq 側で整形用チャットモデルの提供が終了し整形が壊れる事故が起きたため、
#   整形処理は下記の整形バックエンドへ切り離されている)。
#
# --- 整形バックエンドのモデル (任意) --------------------------------------
# 文字起こし後のテキスト整形 (Groq / Local のハイブリッドモードで使用) のモデル。
# GEMINI_MODEL とは別の環境変数なので、音声の文字起こし用モデルを変えても
# 整形バックエンドには影響しない (逆も同様)。どちらの整形バックエンドを使うかは
# settings.json の refine_provider (gemini/nvidia、既定 gemini) で選ぶ。
#
# GEMINI_REFINE_MODEL=gemini-flash-lite-latest
#   既定値。"-latest" は常に最新版を指すエイリアスのため、特定バージョンの
#   提供終了で整形が壊れる事故が構造的に起きにくい。
# NVIDIA_REFINE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
#   既定値。nvidia/nemotron-nano-3-30b-a3b はモデル一覧には出てもアカウントに
#   よっては 404 になることが確認されているため、既定モデルには採用しないこと。
